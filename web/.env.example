# Copier ce fichier en .env.local puis remplir. Ne JAMAIS committer .env.local.

# ---------- Site ----------
NEXT_PUBLIC_URL_SITE=http://localhost:3000

# ---------- Supabase (supabase.com > Project Settings > API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « service_role » : serveur seulement, contourne la RLS. Ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Stripe, MODE TEST seulement (dashboard.stripe.com > Développeurs > Clés API, mode test) ----------
# Le serveur refuse toute clé qui ne commence pas par sk_test_.
STRIPE_SECRET_KEY=sk_test_
# Facultatif en local : secret donné par `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# Sans webhook, la page /paiement/merci confirme quand même le paiement en le vérifiant auprès de Stripe.
STRIPE_WEBHOOK_SECRET=

# ---------- Courriels ----------
# console = rien ne part : affiché dans le terminal et dans Admin > Boîte d'envoi.
# resend  = envoi réel par Resend (ajouter RESEND_API_KEY). Aucun changement de code nécessaire.
COURRIEL_FOURNISSEUR=console
COURRIEL_EXPEDITEUR=Expo St-Isidore <info@expobassinchaudiere.com>
COURRIEL_ADMIN=info@expobassinchaudiere.com
RESEND_API_KEY=

# ---------- Prix fictifs ----------
# true = en développement, les prix « à confirmer » (valeurs de départ fictives) s'affichent au public
# avec la mention « prix fictif » pour pouvoir tester le paiement. Toujours ignoré en production.
AFFICHER_PRIX_FICTIFS=true
